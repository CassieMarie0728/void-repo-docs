# Default: OpenRouter Free. Put your real key in .env or Render's secret settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional self-hosted endpoint (choose Self-hosted or Auto in Setup).
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.2:3b
AI_API_KEY=
AI_TIMEOUT_MS=120000
AI_MAX_TOKENS=4096

# Optional cloud providers. Auto requires the explicit cloud-fallback switch.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GITHUB_TOKEN=
PORT=3000
APP_URL=http://localhost:3000
# Set a strong access token before exposing your backend.
VOID_API_TOKEN=
# Optional Android build default; can also be set in Setup inside the app.
VITE_API_BASE_URL=
